rules_version = '2';

// The API server (Firebase Admin SDK) is the only writer: it authorises every
// mutation, enforces the work-order state machine and writes the audit trail.
// Admin SDK access bypasses these rules, so clients get no write access at all.
//
// Data layout: orgs/{orgId}/{collection}/{docId}
// Custom claims (set with scripts/set-user-claims.ts): { role, orgId }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function inOrg(orgId) {
      return signedIn() && request.auth.token.orgId == orgId;
    }

    function hasRole(roles) {
      return signedIn() && request.auth.token.role in roles;
    }

    function oversight() {
      return hasRole(['ADMIN', 'PROJECT_MANAGER', 'REVIEWER', 'SUPERVISOR']);
    }

    match /orgs/{orgId} {
      // Read-only, org-scoped access for future realtime listeners.
      match /work_orders/{id} {
        allow read: if inOrg(orgId)
          && (oversight() || request.auth.uid in resource.data.assigneeIds);
        allow write: if false;
      }

      match /{collection}/{id} {
        allow read: if inOrg(orgId)
          && collection in ['sites', 'hops', 'inventory', 'tickets', 'photos', 'tssr_approvals'];
        allow write: if false;
      }

      match /audit_logs/{id} {
        allow read: if inOrg(orgId) && hasRole(['ADMIN', 'PROJECT_MANAGER', 'REVIEWER']);
        allow write: if false;
      }
    }

    // Everything else, including the legacy top-level collections, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
