# ---------------------------------------------------------------------------
# Server (read by server/config.ts — validated at startup, invalid values abort)
# ---------------------------------------------------------------------------

# development | test | production.
# Unset: `npm run dev` (TypeScript source) runs as development; the built bundle
# (`npm start`) runs as production. Production refuses AUTH_MODE=dev and DATA_BACKEND=memory.
NODE_ENV="development"
PORT="3000"

# firebase: verify Firebase ID tokens (role/orgId from custom claims; see `npm run set-claims`).
# dev:      accept `Bearer dev:<seedUserId>` demo identities. Local only.
# Default: dev in development, firebase in production.
AUTH_MODE="dev"

# firestore: persist via the Firebase Admin SDK (orgs/{orgId}/{collection}/{id}).
# memory:    seeded in-process store, reset on restart. Local/test only.
# Default: memory in development, firestore in production.
DATA_BACKEND="memory"

# Defaults come from firebase-applet-config.json.
# FIREBASE_PROJECT_ID=""
# FIRESTORE_DATABASE_ID=""

# Admin SDK credentials: on Cloud Run the service account is used automatically.
# Locally: `gcloud auth application-default login` or a service-account key path.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Gemini — server-side only. Never prefix with VITE_ (that would ship it to browsers).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Per-user request limits (per minute, per server instance).
AI_RATE_LIMIT_PER_MIN="20"
API_RATE_LIMIT_PER_MIN="300"

# AI Studio injects this with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Client (Vite, embedded in the browser bundle — never put secrets here)
# ---------------------------------------------------------------------------

# firebase | dev. Must match the server's AUTH_MODE. Default: dev for `vite dev`, firebase for builds.
# VITE_AUTH_MODE="firebase"
