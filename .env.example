# ==============================================================================
# FieldOps MW Enterprise Telecom - Environment Variables
# ==============================================================================

# CRITICAL SECURITY NOTICE:
# NEVER prefix GEMINI_API_KEY with VITE_ (e.g. VITE_GEMINI_API_KEY is FORBIDDEN).
# The Gemini API key must exist strictly on the backend server and must NEVER be
# exposed in client browser bundles or network traffic.
GEMINI_API_KEY=""

# Gemini Model alias (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Application Environment (development | test | production)
NODE_ENV="development"

# Server HTTP Port (default: 3000)
PORT="3000"

# Authentication Mode (firebase | dev)
# Default: 'dev' in development, 'firebase' in production.
# Production throws an error if AUTH_MODE=dev.
AUTH_MODE="dev"

# Client Authentication Mode (optional override, default: dev in dev, firebase in prod)
VITE_AUTH_MODE="dev"

# Data Storage Backend (firestore | memory)
# Default: 'memory' in development, 'firestore' in production.
# Production throws an error if DATA_BACKEND=memory.
DATA_BACKEND="memory"

# Firebase Cloud Project ID & Firestore Database ID (from firebase-applet-config.json)
FIREBASE_PROJECT_ID="gen-lang-client-0442340578"
FIRESTORE_DATABASE_ID="ai-studio-fieldopsmw-0c4fa765-c593-4af5-a2e5-2fd30cac169e"

# Rate Limiting Controls (Requests Per Minute)
AI_RATE_LIMIT_PER_MIN="20"
API_RATE_LIMIT_PER_MIN="300"
