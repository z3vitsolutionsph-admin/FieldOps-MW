rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function inOrg(orgId) { return signedIn() && request.auth.token.orgId == orgId; }
    function hasRole(roles) { return signedIn() && request.auth.token.role in roles; }
    function oversight() { return hasRole(['ADMIN', 'PROJECT_MANAGER', 'REVIEWER', 'SUPERVISOR']); }
    match /orgs/{orgId} {
      match /work_orders/{id} {
        allow read: if inOrg(orgId) && (oversight() || request.auth.uid in resource.data.assigneeIds);
        allow write: if false;
      }
      match /{collection}/{id} {
        allow read: if inOrg(orgId) && collection in ['sites', 'hops', 'inventory', 'tickets', 'photos', 'tssr_approvals'];
        allow write: if false;
      }
      match /audit_logs/{id} {
        allow read: if inOrg(orgId) && hasRole(['ADMIN', 'PROJECT_MANAGER', 'REVIEWER']);
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
