{
  "entities": {
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Microwave installation, dismantling, or troubleshooting work order execution state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "number" },
        "workOrderNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["INSTALLATION", "DISMANTLING", "TROUBLESHOOTING"] },
        "siteId": { "type": "string" },
        "siteRole": { "type": "string", "enum": ["A", "B"] },
        "hopId": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "ASSIGNED", "SCHEDULED", "IN_PROGRESS", "PENDING_REVIEW", "APPROVED", "REJECTED", "CLOSED"] },
        "currentStepIndex": { "type": "number" },
        "assigneeIds": { "type": "array" },
        "orgId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "workOrderNumber", "type", "siteId", "status", "orgId"]
    },
    "PhotoEvidence": {
      "title": "PhotoEvidence",
      "description": "Field photo evidence with HUD watermark metadata and offline status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionCode": { "type": "string" },
        "sectionTitle": { "type": "string" },
        "siteId": { "type": "string" },
        "dataUrl": { "type": "string" },
        "timestamp": { "type": "string" },
        "capturedBy": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "sectionCode", "siteId", "dataUrl", "timestamp", "orgId"]
    },
    "TssrApprovalSheet": {
      "title": "TssrApprovalSheet",
      "description": "TSSR verification and 3-gate engineering approvals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hopId": { "type": "string" },
        "overallStatus": { "type": "string" },
        "orgId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hopId", "overallStatus", "orgId"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Decommissioned microwave equipment with serial number and asset tag",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "equipmentType": { "type": "string" },
        "model": { "type": "string" },
        "serialNumber": { "type": "string" },
        "assetTag": { "type": "string" },
        "condition": { "type": "string" },
        "status": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "siteId", "serialNumber", "assetTag", "orgId"]
    },
    "TroubleshootingTicket": {
      "title": "TroubleshootingTicket",
      "description": "Microwave diagnostic issue ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hopId": { "type": "string" },
        "siteId": { "type": "string" },
        "symptom": { "type": "string" },
        "status": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "hopId", "siteId", "symptom", "status", "orgId"]
    },
    "AuditLogItem": {
      "title": "AuditLogItem",
      "description": "Audit trail log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "action", "targetId", "userId", "timestamp", "orgId"]
    },
    "Site": {
      "title": "Site",
      "description": "Microwave telecom tower site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "name", "orgId"]
    },
    "Hop": {
      "title": "Hop",
      "description": "Microwave link hop geometry and RF profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hopName": { "type": "string" },
        "orgId": { "type": "string" }
      },
      "required": ["id", "hopName", "orgId"]
    }
  },
  "firestore": {
    "/orgs/{orgId}/work_orders/{workOrderId}": {
      "schema": { "$ref": "#/entities/WorkOrder" },
      "description": "Organization-scoped collection of microwave work orders"
    },
    "/orgs/{orgId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/PhotoEvidence" },
      "description": "Organization-scoped collection of installation photo evidence"
    },
    "/orgs/{orgId}/tssr_approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/TssrApprovalSheet" },
      "description": "Organization-scoped collection of TSSR approval documents"
    },
    "/orgs/{orgId}/inventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Organization-scoped collection of decommissioned hardware inventory items"
    },
    "/orgs/{orgId}/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/TroubleshootingTicket" },
      "description": "Organization-scoped collection of troubleshooting diagnostic tickets"
    },
    "/orgs/{orgId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogItem" },
      "description": "Organization-scoped collection of operational audit logs"
    },
    "/orgs/{orgId}/sites/{siteId}": {
      "schema": { "$ref": "#/entities/Site" },
      "description": "Organization-scoped collection of telecom site profiles"
    },
    "/orgs/{orgId}/hops/{hopId}": {
      "schema": { "$ref": "#/entities/Hop" },
      "description": "Organization-scoped collection of microwave hops"
    }
  }
}
